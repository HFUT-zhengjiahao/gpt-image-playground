# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated images
# 生成的图片默认不进仓库；这份仓库是"清空电脑前的完整备份"，所以显式放行图片本身，
# 但回收站、临时文件和登记表缓存仍然排除。
generated-images/*
!generated-images/*.png
!generated-images/*.jpg
!generated-images/*.jpeg
!generated-images/*.webp
generated-images/.trash/
generated-images/index.json.tmp

# local run state (pid/log of the dev server started from the shortcut)
.run/
